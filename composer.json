{
    "name": "pradeepdev001/laravel-smart-filter",
    "description": "A powerful, elegant, and extensible Eloquent filtering package for Laravel 8, 9, 10, 11 & 12.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filter",
        "eloquent",
        "query",
        "smart-filter",
        "api-filter",
        "request-filter"
    ],
    "authors": [
        {
            "name": "Pradeepdev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^8.83 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/database": "^8.83 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^8.83 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^8.83 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/pipeline": "^8.83 || ^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "laravel/framework": "^8.83.27 || ^9.52.21 || ^10.48.9 || ^11.39.1 || ^12.9.2",
        "orchestra/testbench": "^6.47 || ^7.56 || ^8.37 || ^9.17 || ^10.11",
        "pestphp/pest": "^1.22.1 || ^2.36.0 || ^3.8.2",
        "pestphp/pest-plugin-laravel": "^1.4.0 || ^2.4.0 || ^3.2.0",
        "phpstan/phpstan": "^1.0 || ^2.0",
        "larastan/larastan": "^1.0 || ^2.0 || ^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Pradeepdev\\SmartFilter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pradeepdev\\SmartFilter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pradeepdev\\SmartFilter\\SmartFilterServiceProvider"
            ],
            "aliases": {
                "SmartFilter": "Pradeepdev\\SmartFilter\\Facades\\SmartFilter"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
